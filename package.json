{
  "name": "fullgpu-render",
  "version": "0.1.0",
  "private": true,
  "description": "Programmatic video rendering that stays on the GPU end to end (NVDEC -> wgpu/WebGPU -> NVENC)",
  "license": "MIT OR Apache-2.0",
  "repository": "github:WassimAarab08/fullgpu-render",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test scene/scene.test.mjs tools/verify.test.mjs tools/bench.test.mjs browser/server.test.mjs",
    "layout": "node scene/scene.mjs > out/layout.json",
    "media": "bash tools/make-sample-media.sh",
    "render:browser": "node browser/server.mjs --out=browser.mp4",
    "bench": "bash tools/run-bench.sh"
  },
  "dependencies": {
    "mediabunny": "1.62.0"
  }
}
